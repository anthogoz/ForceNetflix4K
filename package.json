{
  "name": "force-netflix-4k",
  "description": "Browser extension for Chrome and Firefox that spoofs screen parameters on Netflix to trick the site into detecting a 4K display.",
  "version": "1.0.1",
  "author": "Lnkhey",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "typecheck": "wxt prepare && vue-tsc -b --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/i18n": "^0.2.5",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.4",
    "wxt": "^0.20.26"
  }
}
